{ config, pkgs, ... }:

let
  ns       = "prwns";               # namespace name
  wgIf     = "wg1";                 # wg0 is taken by qbtns, keep these distinct
  vethHost = "veth-prw0";
  vethNs   = "veth-prw1";
  hostIp   = "10.200.201.1";        # different subnet from qbtns' 10.200.200.0/24
  nsIp     = "10.200.201.2";
  prefix   = "24";

  mullvadAddress = "10.x.x.x/32";   # the "Address" line from your SECOND mullvad conf
  mullvadDns     = "10.64.0.1";     # the "DNS" line from your SECOND mullvad conf
in
{
  environment.etc."netns/${ns}/resolv.conf".text = ''
    nameserver ${mullvadDns}
  '';

  systemd.services."${ns}-wg" = {
    description = "wireguard + veth for ${ns} netns";
    bindsTo  = [ "netns@${ns}.service" ];
    requires = [ "network-online.target" ];
    after    = [ "netns@${ns}.service" "network-online.target" ];
    wantedBy = [ "multi-user.target" ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStart = pkgs.writeShellScript "${ns}-up" ''
        set -e
        ip="${pkgs.iproute2}/bin/ip"
        wg="${pkgs.wireguard-tools}/bin/wg"
        wgq="${pkgs.wireguard-tools}/bin/wg-quick"

	$ip -n ${ns} link del ${wgIf} 2>/dev/null || true
        $ip link del ${vethHost} 2>/dev/null || true

        $ip link add ${wgIf} type wireguard
        $ip link set ${wgIf} netns ${ns}
        $ip -n ${ns} address add ${mullvadAddress} dev ${wgIf}
        $ip netns exec ${ns} $wg setconf ${wgIf} <($wgq strip /root/secrets/mullvad-prowlarr.conf)
        $ip -n ${ns} link set ${wgIf} up
        $ip -n ${ns} route add default dev ${wgIf}

        $ip link add ${vethHost} type veth peer name ${vethNs}
        $ip link set ${vethNs} netns ${ns}
        $ip addr add ${hostIp}/${prefix} dev ${vethHost}
        $ip link set ${vethHost} up
        $ip -n ${ns} addr add ${nsIp}/${prefix} dev ${vethNs}
        $ip -n ${ns} link set ${vethNs} up
        $ip -n ${ns} link set lo up
      '';
      ExecStop = pkgs.writeShellScript "${ns}-down" ''
        ${pkgs.iproute2}/bin/ip link del ${vethHost} 2>/dev/null || true
        ${pkgs.iproute2}/bin/ip -n ${ns} link del ${wgIf} 2>/dev/null || true
      '';
    };
  };

  # bind the existing prowlarr service (from media.nix) into the namespace
  systemd.services.prowlarr = {
    bindsTo = [ "${ns}-wg.service" ];
    after   = [ "${ns}-wg.service" ];
    serviceConfig = {
      NetworkNamespacePath = "/var/run/netns/${ns}";
      BindReadOnlyPaths = [ "/etc/netns/${ns}/resolv.conf:/etc/resolv.conf" ];
    };
  };

  # webui lives inside the namespace now, proxy it back out so the LAN can still reach it
  systemd.services.prowlarr-webui-proxy = {
    description = "proxy to prowlarr webui inside ${ns}";
    after    = [ "${ns}-wg.service" ];
    bindsTo  = [ "${ns}-wg.service" ];
    wantedBy = [ "multi-user.target" ];
    serviceConfig = {
      ExecStart = "${pkgs.socat}/bin/socat TCP-LISTEN:9696,fork,reuseaddr TCP:${nsIp}:9696";
      Restart = "always";
    };
  };

  networking.firewall.allowedTCPPorts = [ 9696 ];
}
